# ==============================
# CivicLens AI - Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# SQLite database
*.db
*.sqlite
*.sqlite3

# Uploaded documents
backend/uploads/*
!backend/uploads/.gitkeep

# Python test/cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log

# Node
frontend/node_modules/

# Frontend build output
frontend/dist/

# Vite
.vite/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp